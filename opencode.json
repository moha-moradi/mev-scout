{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "opencode": {
            "models": {
                "big-pickle": {
                    "options": {
                        "reasoningEffort": "high"
                    }
                },
                "deepseek-v4-flash": {
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                }
            }
        }
    },
    "plugin": [
        [
            "@skwid138/opencode-council",
            {
                "council": {
                    "models": [
                        {
                            "providerID": "opencode",
                            "modelID": "big-pickle"
                        },
                        {
                            "providerID": "opencode",
                            "modelID": "deepseek-v4-flash-free"
                        },
                        {
                            "providerID": "opencode",
                            "modelID": "nemotron-3-ultra-free"
                        }
                    ],
                    "quorum": 3,
                    "debug": false,
                    "reviewer_temperature": 0.3
                }
            }
        ],
        "envsitter-guard",
        "opencode-worktree",
        "opencode-skillful",
        "@plannotator/opencode",
        "opencode-pty",
        "@opencode/websearch-cited",
        "opencode-supermemory",
        "@openspoon/subtask2"
    ]
}